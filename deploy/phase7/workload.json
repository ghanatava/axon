{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "axon-demo"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "echo-unstripped",
        "namespace": "axon-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "echo-unstripped"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "echo-unstripped",
              "app.kubernetes.io/name": "echo-unstripped",
              "app.kubernetes.io/part-of": "axon-evaluation"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "echo",
                "image": "axon-fixture:unstripped",
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 19090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "24Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "96Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "echo-stripped",
        "namespace": "axon-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "echo-stripped"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "echo-stripped",
              "app.kubernetes.io/name": "echo-stripped",
              "app.kubernetes.io/part-of": "axon-evaluation"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "echo",
                "image": "axon-fixture:stripped",
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 19090
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "24Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "96Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "non-go",
        "namespace": "axon-demo",
        "labels": {
          "app.kubernetes.io/part-of": "axon-evaluation"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "sleep",
            "image": "axon-fixture:stripped",
            "imagePullPolicy": "Never",
            "command": [
              "/bin/sleep",
              "3600"
            ],
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "4Mi"
              },
              "limits": {
                "cpu": "50m",
                "memory": "16Mi"
              }
            }
          }
        ]
      }
    }
  ]
}
