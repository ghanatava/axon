# === Go ===
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
axon-agent

# Test artifacts
*.test
*.out
coverage.txt
coverage.html

# Go build/mod cache artifacts if vendored locally
vendor/

# Go workspace files
go.work
go.work.sum

# === C / eBPF ===
# Compiled objects
*.o
*.ko
*.obj
*.a

# eBPF compiled bytecode objects (keep .bpf.c sources, ignore .bpf.o build output)
*.bpf.o

# libbpf-generated skeletons (regenerate via bpftool gen skeleton — don't commit generated code)
*.skel.h

# Generated vmlinux.h (machine/kernel-specific — regenerate per target, don't commit)
vmlinux.h

# clang/LLVM intermediates
*.ll
*.bc

# Preprocessor / dependency files
*.d

# === cmd/*, poc/*, testtargets/* build output ===
# Only hand-written source is tracked in these dirs -- any compiled binary
# is ignored automatically, whatever it gets named, so this file doesn't
# need editing every time a new debug/poc binary shows up under a new name.
# (classify / classify_stripped fall under this too: kept on disk since
# classify_stripped needs a specific -ldflags="-s -w" build to regenerate
# correctly, now just properly ignored instead of hardcoded here by name.)
cmd/*/*
!cmd/*/*.go
poc/*/*
!poc/*/*.go
!poc/*/*.c
!poc/*/*.h
testtargets/*/*
!testtargets/*/*.go

# bpf2go-generated Go loader + embedded bytecode -- regenerate both via
# `go generate` before building, don't commit either half. The .go embeds
# the sibling .o via go:embed, so committing one without the other leaves
# the repo unbuildable from a fresh clone anyway. Must come after the
# poc/* whitelist above since it's the more specific, later-wins rule.
poc/*/*_bpfel.go
poc/*/*_bpfeb.go

# === Editors / OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# === Build output ===
/dist/
/build/
*.log

# === Local/test env ===
.env
*.local

# === Kubernetes local artifacts ===
kubeconfig
*.kubeconfig

